# Copy to `.env` (never commit the real `.env`) and fill in real values before running
# `docker compose up --build` for anything beyond a local demo.

# Any random 32+ character string — signs JWTs, must stay secret in real use.
JWT_SECRET=CHANGE_ME_dev_only_super_secret_key_min_32_chars

# From @BotFather on Telegram — leave blank to run with the Telegram channel disabled.
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com/apikey — leave blank to run with AI Advisory disabled.
GEMINI_API_KEY=
